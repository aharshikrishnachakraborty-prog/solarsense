# Virtual environment (each person creates their own)
.venv/

# Python cache files
__pycache__/
*.pyc
.pytest_cache/

# Raw Kaggle data (download it yourself — never commit it)
data/raw/

# Trained models are rebuilt by the pipeline (python run_all.py) — too big to commit
models/*.joblib

# Alert statuses changed while using the dashboard (local state, not code)
data/processed/alert_status.json

# Static GitHub Pages copy — built by the GitHub Action (python -m api.export_static), never committed
site/

# Login accounts (hashed passwords, local only)
data/users.json

# Local secrets (n8n webhook address)
.env

# Private team notes (kept locally, not in the repo)
CLAUDE.md
PROMPTS.md
WEATHER_PROMPTS.md
PROGRESS.md
backups
presentation/round1_ppt_prompt.md
presentation/ZERO_TO_HERO.md
presentation/explain_like_im_new.md
presentation/judge_qa.md
presentation/demo_script.md
presentation/slide_outline.md
presentation/plant_showcase.html
